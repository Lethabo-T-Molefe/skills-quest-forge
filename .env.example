# CHIETA Data Lab frontend — environment
# Copy to .env.local:  Copy-Item .env.example .env.local  (PowerShell)
#                       cp .env.example .env.local          (bash)

# Backend API
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Playground service URLs — used as a fallback if the backend's
# GET /playground/links isn't reachable. Match /playground/.env.example.
VITE_JUPYTERHUB_URL=http://localhost:8100
VITE_SUPERSET_URL=http://localhost:8088
VITE_MLFLOW_URL=http://localhost:5000
VITE_CODE_SERVER_URL=http://localhost:8443
