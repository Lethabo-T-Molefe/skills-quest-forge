# Used by `npm run build` (production builds), and committed: these are public addresses, not secrets.
# `npm run dev` keeps using .env. A variable set on the build host overrides the value here.

# The deployed DataForge API, including the version prefix.
VITE_API_URL=https://dataforge-backend-8ohs.onrender.com/api/v1

# Matches the API's MAX_UPLOAD_MB: the Cloudinary Free plan takes raw files up to 10 MB.
VITE_MAX_UPLOAD_MB=9
